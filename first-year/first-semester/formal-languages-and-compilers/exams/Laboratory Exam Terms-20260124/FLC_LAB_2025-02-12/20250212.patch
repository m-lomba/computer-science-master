@@ -0,0 +1,17 @@
+int a, i;
+
+a = 0;
+forall i from 0 to 10 else {
+  a = a + 1;
+}
+write(a);  // prints 10
+forall i from 0 to 10 when 2 {
+  a = a - 1;
+  write(-1);
+} when 7 {
+  a = a - 3;
+  write(-3);
+} else {
+  write(a);
+}
+// prints: 10 10 -1 9 9 9 9 -3 6 6
